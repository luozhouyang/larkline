---
/**
 * Sequence for an approval or user-question request. It shows the stdin /
 * stdout control protocol and the card round-trip.
 */
---
<figure class="nb-diagram">
  <svg viewBox="0 0 1100 700" role="img" aria-labelledby="seq-title seq-desc" style="width:100%;height:auto">
    <title id="seq-title">Approval and question sequence</title>
    <desc id="seq-desc">The agent emits a control request; the bridge posts a card; the initiator clicks; the bridge sends a control response and the agent continues.</desc>
    <defs>
      <marker id="seq-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--nb-muted-foreground)" />
      </marker>
    </defs>

    <g font-family="ui-sans-serif, system-ui, sans-serif">
      <!-- Actors -->
      <rect x="60" y="20" width="190" height="56" rx="10" fill="var(--nb-card)" stroke="var(--nb-border-strong)" stroke-width="1.5" />
      <text x="155" y="45" text-anchor="middle" font-size="17" font-weight="700" fill="var(--nb-foreground)">User</text>
      <text x="155" y="64" text-anchor="middle" font-size="13" fill="var(--nb-muted-foreground)">run initiator</text>

      <rect x="455" y="20" width="190" height="56" rx="10" fill="var(--nb-brand-wash)" stroke="var(--nb-brand)" stroke-width="1.5" />
      <text x="550" y="45" text-anchor="middle" font-size="17" font-weight="700" fill="var(--nb-foreground)">Bridge</text>
      <text x="550" y="64" text-anchor="middle" font-size="13" fill="var(--nb-muted-foreground)">run loop + cards</text>

      <rect x="850" y="20" width="190" height="56" rx="10" fill="var(--nb-card)" stroke="var(--nb-border-strong)" stroke-width="1.5" />
      <text x="945" y="45" text-anchor="middle" font-size="17" font-weight="700" fill="var(--nb-foreground)">Agent</text>
      <text x="945" y="64" text-anchor="middle" font-size="13" fill="var(--nb-muted-foreground)">Claude Code / Codex</text>

      <!-- Lifelines -->
      <line x1="155" y1="76" x2="155" y2="650" stroke="var(--nb-border)" stroke-width="1" stroke-dasharray="5 5" />
      <line x1="550" y1="76" x2="550" y2="650" stroke="var(--nb-border)" stroke-width="1" stroke-dasharray="5 5" />
      <line x1="945" y1="76" x2="945" y2="650" stroke="var(--nb-border)" stroke-width="1" stroke-dasharray="5 5" />

      <!-- 1: user message -->
      <line x1="155" y1="120" x2="550" y2="120" stroke="var(--nb-muted-foreground)" stroke-width="1.5" marker-end="url(#seq-arrow)" />
      <text x="352" y="111" text-anchor="middle" font-size="17" fill="var(--nb-foreground)" paint-order="stroke" stroke="var(--nb-background)" stroke-width="4">1. message</text>

      <!-- 2: spawn -->
      <line x1="550" y1="165" x2="945" y2="165" stroke="var(--nb-muted-foreground)" stroke-width="1.5" marker-end="url(#seq-arrow)" />
      <text x="748" y="156" text-anchor="middle" font-size="17" fill="var(--nb-foreground)" paint-order="stroke" stroke="var(--nb-background)" stroke-width="4">2. spawn / resume · stdin</text>

      <!-- 3: control request -->
      <line x1="945" y1="220" x2="550" y2="220" stroke="var(--nb-warning)" stroke-width="1.5" marker-end="url(#seq-arrow)" />
      <text x="748" y="211" text-anchor="middle" font-size="17" fill="var(--nb-foreground)" paint-order="stroke" stroke="var(--nb-background)" stroke-width="4">3. can_use_tool / requestUserInput</text>

      <!-- 4: card -->
      <line x1="550" y1="275" x2="155" y2="275" stroke="var(--nb-warning)" stroke-width="1.5" marker-end="url(#seq-arrow)" />
      <text x="352" y="266" text-anchor="middle" font-size="17" fill="var(--nb-foreground)" paint-order="stroke" stroke="var(--nb-background)" stroke-width="4">4. approval / question card</text>

      <!-- 5: click -->
      <line x1="155" y1="335" x2="550" y2="335" stroke="var(--nb-success)" stroke-width="1.5" marker-end="url(#seq-arrow)" />
      <text x="352" y="326" text-anchor="middle" font-size="17" fill="var(--nb-foreground)" paint-order="stroke" stroke="var(--nb-background)" stroke-width="4">5. Allow / answer</text>

      <!-- 6: control response -->
      <line x1="550" y1="395" x2="945" y2="395" stroke="var(--nb-success)" stroke-width="1.5" marker-end="url(#seq-arrow)" />
      <text x="748" y="386" text-anchor="middle" font-size="17" fill="var(--nb-foreground)" paint-order="stroke" stroke="var(--nb-background)" stroke-width="4">6. control_response</text>

      <!-- 7: result -->
      <line x1="945" y1="455" x2="550" y2="455" stroke="var(--nb-muted-foreground)" stroke-width="1.5" marker-end="url(#seq-arrow)" />
      <text x="748" y="446" text-anchor="middle" font-size="17" fill="var(--nb-foreground)" paint-order="stroke" stroke="var(--nb-background)" stroke-width="4">7. tool result / answer</text>

      <!-- 8: card update -->
      <line x1="550" y1="515" x2="155" y2="515" stroke="var(--nb-muted-foreground)" stroke-width="1.5" marker-end="url(#seq-arrow)" />
      <text x="352" y="506" text-anchor="middle" font-size="17" fill="var(--nb-foreground)" paint-order="stroke" stroke="var(--nb-background)" stroke-width="4">8. update card · final answer</text>

      <!-- timeout branch -->
      <line x1="550" y1="590" x2="945" y2="590" stroke="var(--nb-danger)" stroke-width="1.3" stroke-dasharray="5 4" marker-end="url(#seq-arrow)" />
      <text x="748" y="581" text-anchor="middle" font-size="17" fill="var(--nb-danger)" paint-order="stroke" stroke="var(--nb-background)" stroke-width="4">10 minutes: deny automatically</text>

      <!-- session grant note -->
      <rect x="60" y="610" width="430" height="40" rx="8" fill="var(--nb-muted)" stroke="var(--nb-border)" />
      <text x="75" y="635" font-size="13" fill="var(--nb-muted-foreground)">Allow for session → updatedPermissions / acceptForSession</text>
      <rect x="520" y="610" width="470" height="40" rx="8" fill="var(--nb-muted)" stroke="var(--nb-border)" />
      <text x="535" y="635" font-size="13" fill="var(--nb-muted-foreground)">Only the run initiator can click; every other sender is rejected</text>
    </g>
  </svg>
  <figcaption>A decision request blocks the agent on stdin/stdout or JSON-RPC. The card click is the only user input the bridge forwards.</figcaption>
</figure>
